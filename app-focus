#!/usr/bin/env python3
"""Focus a running app, or launch it.

The App Focus overlay calls this with --json, --previews, --activate, and
--focus. With no arguments it opens the Omarchy text menu. One window is
focused immediately. Several windows open a preview carousel when this file
is run on its own. A hidden scratchpad is opened before focus. Obsidian,
VS Code, and Tmux launch when nothing matches.
"""

import base64
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
STATE_PATH = RUNTIME / "hypr-focus.json"
PREVIEW_DIR = RUNTIME / "hypr-focus" / "previews"
CONFIG_PATH = Path.home() / ".config" / "omarchy-switcher" / "launches.json"
LAUNCH_GRACE_SECONDS = 3

# search is extra menu text so "vscode" and "vsc" find "VS Code".
# Launch commands are the stock Omarchy ones. ~/.config/omarchy-switcher/launches.json
# replaces any of them with a local argv list.
KNOWN = (
    {
        "id": "obsidian",
        "label": "Obsidian",
        "search": "",
    },
    {
        "id": "vscode",
        "label": "VS Code",
        "search": "vscode",
    },
    {
        "id": "tmux",
        "label": "Tmux",
        "search": "",
    },
)

DEFAULT_LAUNCH = {
    "obsidian": ["uwsm-app", "--", "obsidian"],
    "vscode": ["uwsm-app", "--", "code"],
    "tmux": ["omarchy-launch-terminal-tmux"],
}

ALIASES = {
    "obsidian": "obsidian",
    "code": "vscode",
    "vscode": "vscode",
    "vsc": "vscode",
    "vs code": "vscode",
    "tmux": "tmux",
}


def hyprctl_json(command):
    raw = subprocess.check_output(["hyprctl", command, "-j"], text=True)
    data = json.loads(raw)
    return data if isinstance(data, list) else []


def dispatch(expression):
    result = subprocess.run(
        ["hyprctl", "dispatch", expression],
        capture_output=True,
        text=True,
    )
    output = (result.stdout or "") + (result.stderr or "")
    if result.returncode != 0 or output.strip() != "ok":
        raise RuntimeError(output.strip() or f"dispatch failed: {expression}")


def notify(message):
    subprocess.run(
        ["notify-send", "-a", "Focus", "-u", "low", message],
        check=False,
    )


def cmdline(pid):
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return ""
    return raw.replace(b"\0", b" ").decode(errors="replace")


def token_is_tmux(token):
    if not token or token.startswith("-"):
        return False
    base = os.path.basename(token)
    return base == "tmux" or base.startswith("tmux:")


def cmdline_is_tmux(command):
    return any(token_is_tmux(token) for token in command.split())


def process_tree():
    """pid -> (ppid, cmdline, child pids) for the live process table."""
    found = {}
    proc = Path("/proc")
    for entry in proc.iterdir():
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        ppid = 0
        try:
            for line in (entry / "status").read_text(errors="replace").splitlines():
                if line.startswith("PPid:"):
                    ppid = int(line.split()[1])
                    break
            command = cmdline(pid)
        except (OSError, ValueError):
            continue
        found[pid] = [ppid, command, []]
    for pid, (parent, _command, _children) in found.items():
        parent_row = found.get(parent)
        if parent_row is not None:
            parent_row[2].append(pid)
    return found


def pid_runs_tmux(pid, processes):
    # foot's command line often already contains tmux. If it does not, the
    # client is a child of the shell that foot started.
    stack = [pid]
    seen = set()
    while stack:
        current = stack.pop()
        if not current or current in seen:
            continue
        seen.add(current)
        row = processes.get(current)
        if row is None:
            continue
        _parent, command, children = row
        if cmdline_is_tmux(command):
            return True
        stack.extend(children)
    return False


def window_text(window):
    return " ".join(
        str(window.get(key) or "")
        for key in ("class", "initialClass")
    ).lower()


def detail_for(group):
    status = status_text(group["windows"])
    search = (group.get("search") or "").lower()
    if search and search not in group["label"].lower():
        return f"{search} · {status}"
    return status


def matches_known(app_id, window, processes):
    text = window_text(window)
    if app_id == "obsidian":
        return "obsidian" in text
    if app_id == "vscode":
        return "vscode" in text or "code-oss" in text
    if app_id == "tmux":
        return pid_runs_tmux(window.get("pid") or 0, processes)
    return False


def workspace_name(window):
    workspace = window.get("workspace") or {}
    return str(workspace.get("name") or "")


def status_text(windows):
    if not windows:
        return "not open"
    if len(windows) == 1:
        name = workspace_name(windows[0])
        if name.startswith("special:"):
            return name.split(":", 1)[1] or "scratchpad"
        return f"workspace {name}"
    return f"{len(windows)} windows"


def friendly_class(class_name):
    if class_name == "foot":
        return "Terminal"
    leaf = class_name.rsplit(".", 1)[-1] or class_name
    if leaf.islower():
        return leaf[:1].upper() + leaf[1:]
    return leaf


def sort_windows(windows):
    def key(window):
        workspace = window.get("workspace") or {}
        workspace_id = workspace.get("id") or 0
        special = 1 if workspace_id < 0 else 0
        at = window.get("at") or [0, 0]
        x = at[0] if len(at) > 0 else 0
        y = at[1] if len(at) > 1 else 0
        return (special, workspace_id if workspace_id > 0 else abs(workspace_id), y, x, window.get("address") or "")

    return sorted(windows, key=key)


def launch_commands():
    commands = {key: list(value) for key, value in DEFAULT_LAUNCH.items()}
    try:
        data = json.loads(CONFIG_PATH.read_text())
    except (OSError, json.JSONDecodeError):
        return commands
    if not isinstance(data, dict):
        return commands
    for key, value in data.items():
        if isinstance(value, list) and value and all(isinstance(part, str) and part for part in value):
            commands[str(key)] = value
    return commands


def load_state():
    try:
        return json.loads(STATE_PATH.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(app_id, launched=False):
    payload = {"id": app_id}
    if launched:
        payload["launched_at"] = time.time()
    try:
        STATE_PATH.write_text(json.dumps(payload))
    except OSError:
        pass


def data_dirs():
    home = Path.home()
    raw_home = os.environ.get("XDG_DATA_HOME", "")
    roots = [Path(raw_home) if raw_home else home / ".local" / "share"]
    raw_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share")
    for item in raw_dirs.split(":"):
        if item:
            roots.append(Path(item))
    found = []
    seen = set()
    for root in roots:
        key = str(root)
        if key in seen:
            continue
        seen.add(key)
        found.append(root)
    return found


def read_desktop(path):
    entry = {"id": path.stem, "name": "", "icon": "", "wm_class": "", "nodisplay": False, "handler": False}
    in_entry = False
    for line in path.read_text(errors="replace").splitlines():
        stripped = line.strip()
        if stripped.startswith("["):
            if in_entry:
                break
            in_entry = stripped == "[Desktop Entry]"
            continue
        if not in_entry or "=" not in line or line.startswith("#"):
            continue
        key, value = line.split("=", 1)
        if key == "Name" and not entry["name"]:
            entry["name"] = value.strip()
        elif key == "Icon" and not entry["icon"]:
            entry["icon"] = value.strip()
        elif key == "StartupWMClass" and not entry["wm_class"]:
            entry["wm_class"] = value.strip()
        elif key == "NoDisplay" and value.strip().lower() == "true":
            entry["nodisplay"] = True
    ident = entry["id"].lower()
    name = entry["name"].lower()
    entry["handler"] = "urlhandler" in ident or "url handler" in name
    return entry


def desktop_entries():
    found = {}
    for root in data_dirs():
        folder = root / "applications"
        if not folder.is_dir():
            continue
        for path in folder.glob("*.desktop"):
            if path.name in found:
                continue
            try:
                found[path.name] = read_desktop(path)
            except OSError:
                continue
    return list(found.values())


def icon_score(path):
    text = str(path)
    svg = 2 if path.suffix == ".svg" else 0
    hicolor = 1 if "/hicolor/" in text else 0
    size = 0
    match = re.search(r"/(\d+)x\d+/", text)
    if match:
        size = int(match.group(1))
    elif "/scalable/" in text:
        size = 1024
    return (svg, hicolor, size)


def resolve_icon(name, cache):
    if not name:
        return ""
    if name in cache:
        return cache[name]
    direct = Path(name)
    if direct.is_absolute() and direct.is_file():
        cache[name] = str(direct)
        return cache[name]
    stem = Path(name).name
    for suffix in (".png", ".svg", ".xpm"):
        if stem.endswith(suffix):
            stem = stem[: -len(suffix)]
            break
    best = ""
    best_score = None
    search_roots = [root / "icons" for root in data_dirs()]
    search_roots.append(Path.home() / ".icons")
    search_roots.append(Path("/usr/share/pixmaps"))
    seen = set()
    for base in search_roots:
        key = str(base)
        if key in seen or not base.is_dir():
            continue
        seen.add(key)
        if base.name == "pixmaps":
            candidates = [base / f"{stem}.svg", base / f"{stem}.png"]
        else:
            candidates = list(base.glob(f"*/*/apps/{stem}.svg"))
            candidates.extend(base.glob(f"*/*/apps/{stem}.png"))
            candidates.extend(base.glob(f"*/apps/{stem}.svg"))
            candidates.extend(base.glob(f"*/apps/{stem}.png"))
        for candidate in candidates:
            if not candidate.is_file():
                continue
            score = icon_score(candidate)
            if best_score is None or score > best_score:
                best_score = score
                best = str(candidate)
    cache[name] = best
    return best


def icon_names(group):
    names = []
    group_id = group["id"]
    if group_id.startswith("class:"):
        names.append(group_id.split(":", 1)[1])
    else:
        names.append(group_id)
    if group_id == "tmux":
        names.append("foot")
    elif group_id == "obsidian":
        names.append("md.obsidian.Obsidian")
    elif group_id == "vscode":
        names.append("com.microsoft.VSCode")
        names.append("vscode")
    return [name for name in names if name]


def matching_entry(group, entries):
    wanted = {name.casefold() for name in icon_names(group)}

    def score_of(entry):
        wm = entry["wm_class"].casefold()
        ident = entry["id"].casefold()
        icon = Path(entry["icon"]).name.casefold()
        for suffix in (".png", ".svg", ".xpm"):
            if icon.endswith(suffix):
                icon = icon[: -len(suffix)]
        score = 0
        if wm and wm in wanted:
            score = 100
        elif ident in wanted:
            score = 80
        elif icon in wanted:
            score = 60
        else:
            for name in wanted:
                leaf = name.rsplit(".", 1)[-1]
                if leaf and leaf in {ident, icon, wm}:
                    score = 40
                    break
        if score and entry["handler"]:
            score -= 30
        if score and entry["nodisplay"]:
            score -= 10
        return score

    best = None
    best_score = 0
    for entry in entries:
        score = score_of(entry)
        if score > best_score:
            best = entry
            best_score = score
    return best


def attach_icons(groups):
    entries = desktop_entries()
    cache = {}
    for group in groups:
        entry = matching_entry(group, entries)
        icon_name = entry["icon"] if entry else ""
        if not icon_name and group["id"] == "tmux":
            icon_name = "foot"
        group["icon"] = resolve_icon(icon_name, cache) if icon_name else ""
    return groups


def build_groups(windows):
    processes = process_tree()
    commands = launch_commands()
    claimed = set()
    groups = []

    for app in KNOWN:
        matched = []
        for window in windows:
            address = window.get("address")
            if not address or address in claimed:
                continue
            if matches_known(app["id"], window, processes):
                matched.append(window)
                claimed.add(address)
        groups.append({**app, "launch": commands.get(app["id"]), "windows": sort_windows(matched)})

    by_class = {}
    for window in windows:
        address = window.get("address")
        class_name = window.get("class") or ""
        if not address or address in claimed or not class_name:
            continue
        by_class.setdefault(class_name, []).append(window)

    for class_name in sorted(by_class, key=str.lower):
        groups.append(
            {
                "id": f"class:{class_name}",
                "label": friendly_class(class_name),
                "search": class_name,
                "launch": None,
                "windows": sort_windows(by_class[class_name]),
            }
        )
    return attach_icons(groups)


def ordered_groups(groups):
    last = load_state().get("id")
    if not last:
        return groups
    picked = [group for group in groups if group["id"] == last]
    rest = [group for group in groups if group["id"] != last]
    return picked + rest


def special_visible(name, monitors):
    for monitor in monitors:
        special = (monitor.get("specialWorkspace") or {}).get("name") or ""
        if special == name:
            return True
    return False


def reveal_and_focus(window):
    workspace = workspace_name(window)
    if workspace.startswith("special:") and not special_visible(workspace, hyprctl_json("monitors")):
        scratchpad = workspace.split(":", 1)[1]
        dispatch(f'hl.dsp.workspace.toggle_special("{scratchpad}")')
        deadline = time.monotonic() + 0.4
        while time.monotonic() < deadline:
            if special_visible(workspace, hyprctl_json("monitors")):
                break
            time.sleep(0.02)
    dispatch(f'hl.dsp.focus({{ window = "address:{window["address"]}" }})')


def launch(group):
    command = group.get("launch")
    if not command:
        notify(f"{group['label']} is not open")
        return
    state = load_state()
    launched_at = state.get("launched_at") or 0
    if state.get("id") == group["id"] and time.time() - launched_at < LAUNCH_GRACE_SECONDS:
        notify(f"{group['label']} is launching")
        return
    save_state(group["id"], launched=True)
    result = subprocess.run(command, check=False)
    if result.returncode != 0:
        notify(f"Could not launch {group['label']}")


def focus_window(group, window):
    save_state(group["id"])
    reveal_and_focus(window)


def preview_label(window, used):
    workspace = workspace_name(window)
    if workspace.startswith("special:"):
        place = workspace.split(":", 1)[1] or "scratchpad"
    elif workspace:
        place = f"workspace {workspace}"
    else:
        place = "window"
    title = str(window.get("title") or window.get("class") or "window")
    title = re.sub(r"[\x00-\x1f/\\:*?\"<>|]", " ", title)
    # The preview label turns "-" and "_" into spaces, so keep hyphens as en dashes.
    title = title.replace("-", "–").replace("_", " ")
    title = re.sub(r"\s+", " ", title).strip()
    title = title[:80] or "window"
    base = f"{place} · {title}"
    name = base
    suffix = 2
    while name.casefold() in used:
        name = f"{base} {suffix}"
        suffix += 1
    used.add(name.casefold())
    return name


def capture_window(window, dest):
    stable_id = str(window.get("stableId") or "")
    if not stable_id:
        return False
    result = subprocess.run(
        ["grim", "-t", "jpeg", "-q", "80", "-s", "1", "-T", stable_id, str(dest)],
        capture_output=True,
    )
    return result.returncode == 0 and dest.is_file() and dest.stat().st_size > 0


def placeholder_preview(dest, label):
    result = subprocess.run(
        [
            "magick",
            "-background",
            "#1c1c1c",
            "-fill",
            "#f2f2f2",
            "-gravity",
            "center",
            "-size",
            "960x540",
            f"caption:{label.replace('@', '')}",
            str(dest),
        ],
        capture_output=True,
    )
    return result.returncode == 0 and dest.is_file() and dest.stat().st_size > 0


def layout():
    monitors = []
    for mon in hyprctl_json("monitors"):
        active = mon.get("activeWorkspace") or {}
        special = mon.get("specialWorkspace") or {}
        monitors.append(
            {
                "name": str(mon.get("name") or ""),
                "x": int(mon.get("x") or 0),
                "y": int(mon.get("y") or 0),
                "width": max(1, int(mon.get("width") or 1)),
                "height": max(1, int(mon.get("height") or 1)),
                "active_id": active.get("id"),
                "special": str(special.get("name") or ""),
            }
        )
    spaces = {}
    for space in hyprctl_json("workspaces"):
        spaces[space.get("id")] = {
            "name": str(space.get("name") or ""),
            "monitor": str(space.get("monitor") or ""),
        }
    return monitors, spaces


def monitor_for_window(window, monitors, spaces):
    info = spaces.get((window.get("workspace") or {}).get("id")) or {}
    for mon in monitors:
        if mon["name"] and mon["name"] == info.get("monitor"):
            return mon
    at = window.get("at") or [0, 0]
    size = window.get("size") or [0, 0]
    if len(at) < 2 or len(size) < 2:
        return None
    cx = at[0] + size[0] / 2
    cy = at[1] + size[1] / 2
    for mon in monitors:
        if mon["x"] <= cx < mon["x"] + mon["width"] and mon["y"] <= cy < mon["y"] + mon["height"]:
            return mon
    return None


def neighbor_pair(mon, monitors):
    """The screens immediately left and right of mon, not the one above or below."""
    left = []
    right = []
    for other in monitors:
        if other["name"] == mon["name"]:
            continue
        top = max(mon["y"], other["y"])
        bottom = min(mon["y"] + mon["height"], other["y"] + other["height"])
        if bottom - top < min(mon["height"], other["height"]) * 0.5:
            continue
        if other["x"] + other["width"] <= mon["x"] + 8:
            left.append(other)
        elif other["x"] >= mon["x"] + mon["width"] - 8:
            right.append(other)
    left.sort(key=lambda other: mon["x"] - (other["x"] + other["width"]))
    right.sort(key=lambda other: other["x"] - (mon["x"] + mon["width"]))
    return (left[0] if left else None, right[0] if right else None)


def showing_workspace_id(mon, spaces):
    if mon["special"]:
        for ws_id, info in spaces.items():
            if info["name"] == mon["special"] and info["monitor"] == mon["name"]:
                return ws_id
    return mon["active_id"]


def canvas_for(mon):
    # Cap the long edge so a row of screens still fits a preview.
    fit = min(1.0, 1280 / mon["width"])
    return (
        max(1, int(round(mon["width"] * fit))),
        max(1, int(round(mon["height"] * fit))),
        fit,
    )


def rect_for(window, mon, fit, place=None):
    at = window.get("at") or [0, 0]
    size = window.get("size") or [0, 0]
    if len(at) < 2 or len(size) < 2:
        return None
    if place is None:
        x = (at[0] - mon["x"]) * fit
        y = (at[1] - mon["y"]) * fit
        width = size[0] * fit
        height = size[1] * fit
    else:
        scale, min_x, min_y, target_x, target_y = place
        x = (target_x + (at[0] - min_x) * scale - mon["x"]) * fit
        y = (target_y + (at[1] - min_y) * scale - mon["y"]) * fit
        width = size[0] * scale * fit
        height = size[1] * scale * fit
    if width < 2 or height < 2:
        return None
    return (int(round(x)), int(round(y)), max(1, int(round(width))), max(1, int(round(height))))


def workspace_place(windows, mon):
    """Fit a workspace onto its screen when Hyprland parked it off the monitor.

    Hidden workspaces sometimes report a row of windows wider than the screen,
    or shifted off to one side. Windows that already sit on the monitor stay
    where they are. Otherwise the group is scaled to fit, gaps included.
    """
    boxes = []
    for window in windows:
        at = window.get("at") or []
        size = window.get("size") or []
        if len(at) < 2 or len(size) < 2 or size[0] < 2 or size[1] < 2:
            continue
        boxes.append((at[0], at[1], size[0], size[1]))
    if not boxes:
        return None

    def mostly_on(box):
        x, y, w, h = box
        overlap_w = max(0, min(x + w, mon["x"] + mon["width"]) - max(x, mon["x"]))
        overlap_h = max(0, min(y + h, mon["y"] + mon["height"]) - max(y, mon["y"]))
        return overlap_w * overlap_h >= 0.85 * w * h

    if all(mostly_on(box) for box in boxes):
        return None
    min_x = min(box[0] for box in boxes)
    min_y = min(box[1] for box in boxes)
    span_w = max(1.0, max(box[0] + box[2] for box in boxes) - min_x)
    span_h = max(1.0, max(box[1] + box[3] for box in boxes) - min_y)
    margin = 16
    avail_w = max(1, mon["width"] - margin * 2)
    avail_h = max(1, mon["height"] - margin * 2)
    scale = min(avail_w / span_w, avail_h / span_h, 1.0)
    target_x = mon["x"] + (mon["width"] - span_w * scale) / 2
    target_y = mon["y"] + (mon["height"] - span_h * scale) / 2
    return (scale, min_x, min_y, target_x, target_y)


def magick(args):
    result = subprocess.run(["magick", *args], capture_output=True)
    return result.returncode == 0


def paint_order(windows):
    def key(window):
        history = window.get("focusHistoryID")
        age = history if isinstance(history, int) else 0
        return (1 if window.get("floating") else 0, -age)

    return sorted(windows, key=key)


def composite_windows(windows, shots, mon, fit, width, height, dest, place=None):
    # Each window's own surface, placed where it sits. A live monitor shot
    # would be whichever workspace is on screen now, with this switcher on top.
    args = ["-size", f"{width}x{height}", "xc:#141418"]
    placed = False
    for window in paint_order(windows):
        path = shots.get(window.get("address"))
        box = rect_for(window, mon, fit, place)
        if not path or not box:
            continue
        x, y, w, h = box
        if x >= width or y >= height or x + w <= 0 or y + h <= 0:
            continue
        args += [
            "(",
            str(path),
            "-resize",
            f"{w}x{h}!",
            ")",
            "-geometry",
            f"{x:+d}{y:+d}",
            "-composite",
        ]
        placed = True
    if not placed:
        return False
    return magick([*args, "-quality", "80", str(dest)])


def highlight_window(base, target_path, box, width, height, dest):
    x, y, w, h = box
    margin = 4
    x1 = min(max(x + margin, 2), width - 3)
    y1 = min(max(y + margin, 2), height - 3)
    x2 = max(min(x + w - margin, width - 3), x1 + 2)
    y2 = max(min(y + h - margin, height - 3), y1 + 2)
    return magick(
        [
            str(base),
            "-blur",
            "0x8",
            "(",
            str(target_path),
            "-resize",
            f"{w}x{h}!",
            ")",
            "-geometry",
            f"{x:+d}{y:+d}",
            "-composite",
            "-stroke",
            "#0b0b10",
            "-strokewidth",
            "12",
            "-fill",
            "none",
            "-draw",
            f"rectangle {x1},{y1} {x2},{y2}",
            "-stroke",
            "#f6f6f2",
            "-strokewidth",
            "4",
            "-fill",
            "none",
            "-draw",
            f"rectangle {x1},{y1} {x2},{y2}",
            "-quality",
            "82",
            str(dest),
        ]
    )


def dim_panel(src, dest):
    return magick(
        [
            str(src),
            "-blur",
            "0x6",
            "-fill",
            "black",
            "-colorize",
            "38%",
            "-quality",
            "75",
            str(dest),
        ]
    )


def match_height(src, height, dest):
    return magick([str(src), "-resize", f"x{height}", "-quality", "75", str(dest)])


def append_panels(left, center, right, dest):
    parts = [str(path) for path in (left, center, right) if path]
    if not parts:
        return False
    if len(parts) == 1:
        shutil.copy(parts[0], dest)
        return dest.is_file()
    return magick([*parts, "+append", "-quality", "82", str(dest)])


def capture_shots(windows, raw_dir):
    jobs = []
    seen = set()
    for window in windows:
        address = window.get("address") or ""
        stable_id = str(window.get("stableId") or "")
        if not address or not stable_id or address in seen:
            continue
        seen.add(address)
        jobs.append((window, raw_dir / f"{stable_id}.jpg"))

    def shoot(job):
        window, dest = job
        if capture_window(window, dest):
            return window.get("address"), dest
        return window.get("address"), None

    shots = {}
    if not jobs:
        return shots
    with ThreadPoolExecutor(max_workers=4) as pool:
        for address, dest in pool.map(shoot, jobs):
            if dest is not None:
                shots[address] = dest
    return shots


def write_previews(windows):
    if PREVIEW_DIR.exists():
        shutil.rmtree(PREVIEW_DIR)
    PREVIEW_DIR.mkdir(parents=True)
    work = PREVIEW_DIR / "work"
    work.mkdir()
    monitors, spaces = layout()
    clients = [client for client in hyprctl_json("clients") if client.get("address") and client.get("class")]
    by_ws = {}
    for client in clients:
        by_ws.setdefault((client.get("workspace") or {}).get("id"), []).append(client)

    needed = []
    seen = set()

    def add(window):
        address = window.get("address")
        if address and address not in seen:
            seen.add(address)
            needed.append(window)

    targets = []
    for window in windows:
        mon = monitor_for_window(window, monitors, spaces)
        ws_id = (window.get("workspace") or {}).get("id")
        for peer in by_ws.get(ws_id, []):
            add(peer)
        add(window)
        left = right = None
        if mon:
            left, right = neighbor_pair(mon, monitors)
            for side in (left, right):
                if side:
                    for peer in by_ws.get(showing_workspace_id(side, spaces), []):
                        add(peer)
        targets.append((window, mon, left, right))

    shots = capture_shots(needed, work)
    side_panels = {}
    for _window, _mon, left, right in targets:
        for side in (left, right):
            if not side or side["name"] in side_panels:
                continue
            peers = by_ws.get(showing_workspace_id(side, spaces), [])
            width, height, fit = canvas_for(side)
            raw = work / f"side-{side['name']}.jpg"
            dimmed = work / f"side-{side['name']}-dim.jpg"
            panel = None
            place = workspace_place(peers, side)
            if peers and composite_windows(peers, shots, side, fit, width, height, raw, place) and dim_panel(raw, dimmed):
                panel = dimmed
            side_panels[side["name"]] = panel

    fitted_sides = {}
    for _window, mon, left, right in targets:
        if not mon:
            continue
        _width, height, _fit = canvas_for(mon)
        for side in (left, right):
            if not side:
                continue
            key = (side["name"], height)
            if key in fitted_sides:
                continue
            panel = side_panels.get(side["name"])
            dest = work / f"fit-{side['name']}-{height}.jpg"
            fitted_sides[key] = dest if panel and match_height(panel, height, dest) else None

    used = set()
    jobs = []
    for window, mon, left, right in targets:
        label = preview_label(window, used)
        dest = PREVIEW_DIR / f"{label}.jpg"
        jobs.append((window, mon, left, right, dest, label))

    def shoot(job):
        window, mon, left, right, dest, label = job
        shot = shots.get(window.get("address"))
        if mon and shot:
            width, height, fit = canvas_for(mon)
            peers = by_ws.get((window.get("workspace") or {}).get("id"), [window])
            place = workspace_place(peers, mon)
            box = rect_for(window, mon, fit, place)
            safe = re.sub(r"[^A-Za-z0-9]+", "", str(window.get("stableId") or "w"))
            flat = work / f"flat-{safe}.jpg"
            marked = work / f"mark-{safe}.jpg"
            if (
                box
                and composite_windows(peers, shots, mon, fit, width, height, flat, place)
                and highlight_window(flat, shot, box, width, height, marked)
            ):
                left_path = fitted_sides.get((left["name"], height)) if left else None
                right_path = fitted_sides.get((right["name"], height)) if right else None
                if append_panels(left_path, marked, right_path, dest):
                    return window, dest
        if shot:
            shutil.copy(shot, dest)
            return window, dest
        if placeholder_preview(dest, label):
            return window, dest
        return window, None

    with ThreadPoolExecutor(max_workers=3) as pool:
        shot = list(pool.map(shoot, jobs))
    shutil.rmtree(work, ignore_errors=True)
    return [(window, dest) for window, dest in shot if dest is not None]


def pick_preview(windows):
    """Show captured windows. Return the chosen window, or None if cancelled."""
    captured = write_previews(windows)
    if not captured:
        return pick_window_text(windows)

    by_path = {str(dest): window for window, dest in captured}
    recent = min(windows, key=lambda window: window.get("focusHistoryID", 10**9))
    selected = next((str(dest) for window, dest in captured if window is recent), "")
    rows = "\n".join(f"{dest}\t{dest}" for _window, dest in captured)
    encoded = base64.b64encode(rows.encode()).decode()

    selection_file = tempfile.NamedTemporaryFile(prefix="hypr-focus-", delete=False)
    selection_path = Path(selection_file.name)
    selection_file.close()
    done_file = tempfile.NamedTemporaryFile(prefix="hypr-focus-done-", delete=False)
    done_path = Path(done_file.name)
    done_file.close()
    done_path.unlink(missing_ok=True)

    try:
        opened = subprocess.run(
            [
                "omarchy-shell",
                "image-selector",
                "open",
                "",
                encoded,
                selected,
                str(selection_path),
                str(done_path),
                "true",
                "true",
            ],
            capture_output=True,
            text=True,
        )
        if opened.returncode != 0 or opened.stdout.strip() != "ok":
            return pick_window_text(windows)
        deadline = time.monotonic() + 120
        while not done_path.exists():
            if time.monotonic() > deadline:
                subprocess.run(
                    ["omarchy-shell", "image-selector", "cancel", str(done_path)],
                    check=False,
                )
                return None
            time.sleep(0.05)
        if not selection_path.is_file() or selection_path.stat().st_size == 0:
            return None
        chosen = selection_path.read_text().strip()
        window = by_path.get(chosen)
        if window is not None:
            return window
        chosen_name = Path(chosen).name
        for path, item in by_path.items():
            if Path(path).name == chosen_name:
                return item
        return None
    finally:
        selection_path.unlink(missing_ok=True)
        done_path.unlink(missing_ok=True)


def pick_window_text(windows):
    options = []
    by_label = {}
    used = set()
    for window in windows:
        label = preview_label(window, used)
        by_label[label] = window
        workspace = workspace_name(window)
        place = workspace.split(":", 1)[1] if workspace.startswith("special:") else f"workspace {workspace}"
        options.append(f"\t{label}\t{place}")
    result = subprocess.run(
        ["omarchy-menu-select", "Choose window", *options, "--", "--width", "640", "--maxheight", "520"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return None
    label = result.stdout.split("\t", 1)[0].strip()
    return by_label.get(label)


def activate(group):
    windows = group["windows"]
    if not windows:
        launch(group)
        return False
    if len(windows) == 1:
        focus_window(group, windows[0])
        return True
    window = pick_preview(windows)
    if window is None:
        return False
    focus_window(group, window)
    return True


def resolve(query, groups):
    wanted = ALIASES.get(query.strip().lower(), query.strip().lower())
    exact = []
    partial = []
    for group in groups:
        names = {group["id"].lower(), group["label"].lower()}
        if group["id"].startswith("class:"):
            names.add(group["id"].split(":", 1)[1].lower())
        if wanted in names:
            exact.append(group)
        elif any(wanted in name for name in names):
            partial.append(group)
    if len(exact) == 1:
        return exact[0]
    if len(exact) > 1:
        return None
    if len(partial) == 1:
        return partial[0]
    return None


SEARCH_EXTRA = {
    "obsidian": "obsidian",
    "vscode": "code vscode vsc vs code",
    "tmux": "tmux",
}


def public_groups(groups):
    payload = []
    for group in groups:
        extra = SEARCH_EXTRA.get(group["id"], "")
        payload.append(
            {
                "id": group["id"],
                "label": group["label"],
                "detail": detail_for(group),
                "count": len(group["windows"]),
                "icon": group.get("icon") or "",
                "search": " ".join(
                    part
                    for part in (group.get("search") or "", group["label"], group["id"], extra)
                    if part
                ),
            }
        )
    return payload


def focus_address(group, address):
    for window in group["windows"]:
        if window.get("address") == address:
            focus_window(group, window)
            return
    notify("That window closed")
    raise SystemExit(1)


def preview_payload(group):
    rows = []
    for window, dest in write_previews(group["windows"]):
        rows.append(
            {
                "address": window.get("address") or "",
                "label": dest.stem,
                "image": str(dest),
            }
        )
    if not rows:
        return rows
    recent = min(group["windows"], key=lambda window: window.get("focusHistoryID", 10**9))
    recent_address = recent.get("address")
    rows.sort(key=lambda row: 0 if row["address"] == recent_address else 1)
    return rows


def pick_from_menu(groups):
    options = [f"\t{group['label']}\t{detail_for(group)}" for group in groups]
    result = subprocess.run(
        [
            "omarchy-menu-select",
            "Focus app",
            *options,
            "--",
            "--width",
            "440",
            "--maxheight",
            "520",
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return None
    label = result.stdout.split("\t", 1)[0].strip()
    if not label:
        return None
    for group in groups:
        if group["label"] == label:
            return group
    return resolve(label, groups)


def main():
    windows = [window for window in hyprctl_json("clients") if window.get("address") and window.get("class")]
    groups = build_groups(windows)
    args = sys.argv[1:]
    if args == ["--json"]:
        print(json.dumps(public_groups(ordered_groups(groups))), flush=True)
        return
    if len(args) == 2 and args[0] == "--previews":
        group = resolve(args[1], groups)
        if group is None:
            notify(f"No app matching {args[1]}")
            sys.exit(1)
        print(json.dumps(preview_payload(group)), flush=True)
        return
    if len(args) == 2 and args[0] == "--activate":
        group = resolve(args[1], groups)
        if group is None:
            notify(f"No app matching {args[1]}")
            sys.exit(1)
        if len(group["windows"]) > 1:
            focus_window(group, min(group["windows"], key=lambda window: window.get("focusHistoryID", 10**9)))
            return
        activate(group)
        return
    if len(args) == 3 and args[0] == "--focus":
        group = resolve(args[1], groups)
        if group is None:
            notify(f"No app matching {args[1]}")
            sys.exit(1)
        focus_address(group, args[2])
        return
    query = " ".join(args).strip()
    if query == "--list":
        for group in ordered_groups(groups):
            print(f"{group['id']}\t{group['label']}\t{detail_for(group)}\t{len(group['windows'])}")
        return
    if query:
        group = resolve(query, groups)
        if group is None:
            notify(f"No app matching {query}")
            sys.exit(1)
        if not activate(group) and group["windows"]:
            return
        return

    shown = ordered_groups(groups)
    while True:
        group = pick_from_menu(shown)
        if group is None:
            return
        if activate(group):
            return
        if not group["windows"]:
            return


if __name__ == "__main__":
    try:
        main()
    except RuntimeError as error:
        notify(str(error))
        sys.exit(1)
